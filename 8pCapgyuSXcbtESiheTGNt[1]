raft/_next/static/chunks/21bdesykvvzqz.js\",\"https://d1yd7w8qu2dp4i.cloudfront.net/craft/_next/static/chunks/3sha7sbhkjyk5.js\",\"https://d1yd7w8qu2dp4i.cloudfront.net/craft/_next/static/chunks/11n1vtdoyv8cd.js\",\"https://d1yd7w8qu2dp4i.cloudfront.net/craft/_next/static/chunks/1f90a4pd1_dh_.js\",\"https://d1yd7w8qu2dp4i.cloudfront.net/craft/_next/static/chunks/1t0v-_i62k1o3.js\"],\"FrontpageIntlBoundary\"]\n3e:[\"$\",\"$L3f\",null,{\"locale\":\"en\",\"messages\":{\"common\":{\"getStartedFree\":\"Get started for free\",\"getStarted\":\"Get started\",\"noCreditCard\":\"No credit card required.\",\"preziHome\":\"Prezi home\",\"preziCustomer\":\"Prezi customer\",\"copyright\":\"© 2026 Prezi Inc.\",\"tagline\":\"The presentation platform built for engagement.\",\"taglineSub\":\"Create, present, engage, and get smarter every time.\"},\"nav\":{\"pricing\":\"Pricing\",\"preziAi\":\"Prezi AI\",\"logIn\":\"Log in\",\"teams\":\"Teams\",\"signIn\":\"Sign in\",\"openNavMenu\":\"Open navigation menu\",\"closeNavMenu\":\"Close navigation menu\",\"navigation\":\"Navigation\",\"appearance\":\"Appearance\",\"myDashboard\":\"My dashboard\",\"accountSettings\":\"Account Settings\",\"settings\":\"Settings\",\"logout\":\"Logout\",\"accountSubtitle\":\"Prezi.com\",\"accountFallbackName\":\"Account\"},\"hero\":{\"headingStart\":\"The presentation is where it starts, \",\"headingEnd\":\"not where it ends.\",\"subheading\":\"Prezi helps you hold the room, make ideas click, and keep them alive after everyone leaves, so what you say is what they remember.\"},\"howItWorks\":{\"eyebrow\":\"Made to stick\",\"heading\":\"What lands in the room stays with them after.\",\"play\":\"Play\",\"pause\":\"Pause\",\"tabs\":[{\"label\":\"Start where you are\",\"body\":\"Bring the deck you already have, or describe what you need and Prezi drafts it.\"},{\"label\":\"Keep attention\",\"body\":\"Present on a zoomable canvas that shows how your ideas connect, so people follow the shape of the argument, not just the next slide.\"},{\"label\":\"Engage\",\"body\":\"Drop in live polls, quizzes, and Q\u0026A that everyone joins from their phone, so passive watching turns into active thinking.\"},{\"label\":\"Share anywhere\",\"body\":\"Send a link, video, or podcast afterward, then see what landed with quiz results and end-of-session feedback.\"}]},\"outcomes\":{\"sections\":[{\"eyebrow\":\"Every voice\",\"title\":\"Get the whole room involved, even when the session is remote.\",\"body\":\"In most rooms, the same three people answer everything. Prezi changes the math. One QR code and every phone becomes a way to ask, answer, vote, and react, with no app to download and no login. Questions collect before, during, and after, and the group upvotes what it most wants answered. Works the same whether they're ten feet away or ten time zones.\",\"bullets\":[{\"lead\":\"Nothing to install\",\"detail\":\"No app, no account, no barrier. They scan and they're in.\"},{\"lead\":\"The best questions rise\",\"detail\":\"The audience upvotes what it most wants answered, and you keep control with a moderation queue.\"},{\"lead\":\"Remote counts as present\",\"detail\":\"The same polls, quizzes, and Q\u0026A whether they're in the hall, on a call, or half-and-half.\"}]},{\"eyebrow\":\"All in one place\",\"title\":\"One tool does what four used to.\",\"body\":\"Most presenters run a session across a deck tool, a polling tool, a form builder, and a screen recorder, then hope nothing breaks live. Prezi runs it all in one: present, launch a poll, open Q\u0026A, close with a quiz, share the link afterward, without ever leaving what you're presenting.\",\"bullets\":[{\"lead\":\"Build it fast\",\"detail\":\"describe what you need and AI drafts it; or import your existing PowerPoint, Doc, or PDF and go from there.\"},{\"lead\":\"Run it all from one screen\",\"detail\":\"presenting, polls, quizzes, and Q\u0026A live in the same flow, not in another tab.\"},{\"lead\":\"It already matches you\",\"detail\":\"add your logo, colors, and style once; everything you make carries your brand.\"}]},{\"eyebrow\":\"After the session\",\"title\":\"The session ends. The learning doesn't.\",\"body\":\"What you presented becomes a link that keeps teaching. People revisit the material as a narrated video, listen to it as a podcast on the commute, quiz themselves on it, or ask it questions and get answers from your content. The ones who missed it catch up without a reschedule.\",\"bullets\":[{\"lead\":\"Review on their terms\",\"detail\":\"video, podcast, transcript, slides, or the full Prezi; every learner picks their format.\"},{\"lead\":\"Self-check built in\",\"detail\":\"quizzes generated from your content let people test what they actually retained.\"},{\"lead\":\"You stay in control\",\"detail\":\"private, unlisted, or public; invite specific people; your branding, your call-to-action button.\"}]},{\"eyebrow\":\"Close the gap\",\"title\":\"Find out what stuck, before it's too late to fix.\",\"body\":\"You're accountable for what people walk away knowing, and guessing isn't a strategy. Quiz results show which concepts landed and which need another pass. Q\u0026A shows where the confusion lives. An end-of-session feedback request tells you how it went, in their words, delivered straight to you. Next session, you're not starting from hope. You're starting from evidence.\",\"bullets\":[{\"lead\":\"See comprehension, not vibes\",\"detail\":\"quiz and poll results by question, so gaps are visible while you can still act on them.\"},{\"lead\":\"Hear the honest version\",\"detail\":\"ratings and comments collected at the end, digested for you.\"},{\"lead\":\"Teach the next one sharper\",\"detail\":\"every session tells you exactly what to adjust.\"}]}]},\"audienceTabs\":{\"mobileHeading\":\"Built for the people accountable for what sticks.\",\"desktopEyebrow\":\"Who it's for\",\"desktopHeading\":\"Made for people who need ideas to land.\",\"audiences\":{\"trainers\":{\"label\":\"Trainers\",\"headline\":\"Training people actually finish\",\"summary\":\"Create onboarding and training people finish—with participation and proof built in.\",\"ctaLabel\":\"Explore Prezi for training\",\"outcomes\":[{\"title\":\"Onboarding that gets completed\",\"body\":\"Engaging live sessions plus self-paced review that people finish, instead of clicking through to the end.\"},{\"title\":\"Proof for stakeholders\",\"body\":\"SCORM export to your LMS, plus completion and comprehension data you can put in front of leadership.\"}]},\"teachers\":{\"label\":\"Teachers\",\"headline\":\"Lessons that hold the room\",\"summary\":\"Turn every seat into an active part of the lesson, then give students a way to review.\",\"ctaLabel\":\"Explore Prezi for teachers\",\"outcomes\":[{\"title\":\"Participation from every seat\",\"body\":\"Live polls, quizzes, and Q\u0026A turn passive watching into active thinking, even with a full class.\"},{\"title\":\"Review that sticks\",\"body\":\"Students revisit the lesson as a link or a narrated video until the idea actually clicks.\"}]},\"professors\":{\"label\":\"Professors\",\"headline\":\"Lectures worth showing up for\",\"summary\":\"Keep the lecture hall engaged and see exactly where the class needs another pass.\",\"ctaLabel\":\"Explore Prezi for higher ed\",\"outcomes\":[{\"title\":\"Engagement in the hall and online\",\"body\":\"The same interactive lecture works in person, over video, and asynchronously for students who miss it.\"},{\"title\":\"See what students grasped\",\"body\":\"Comprehension and attention data show exactly where the class needs another pass.\"}]}},\"artwork\":{\"onboarding\":\"Onboarding\",\"completed\":\"completed\",\"quickClassPoll\":\"Quick class poll\",\"conceptCheck\":\"Concept check\",\"liveResponses\":\"Live responses\"}},\"socialProof\":{\"eyebrow\":\"Proven in the room\",\"heading\":\"Proof that it sticks.\",\"recognizedByG2\":\"Recognized by G2\",\"outOf5\":\"out of 5\",\"starRatingLabel\":\"4.6 out of 5 stars\",\"g2Badges\":[{\"alt\":\"G2 Audience Response Leader\",\"label\":\"Audience Response Leader\"},{\"alt\":\"G2 AI Presentation Tools Leader\",\"label\":\"AI Presentation Tools Leader\"},{\"alt\":\"G2 Presentation Software Leader\",\"label\":\"Presentation Software Leader\"}],\"stats\":[{\"value\":\"170M+\",\"label\":\"people use Prezi worldwide\"},{\"value\":\"500M+\",\"label\":\"presentations created with Prezi\"},{\"value\":\"195+\",\"label\":\"countries where Prezi is used\"}],\"quotes\":[{\"quote\":\"I used Prezi at a global event attended by several heads of state — a unique experience for many in the audience.\",\"name\":\"S.B.\"},{\"quote\":\"Prezi AI is a game-changer….All I have to do is upload my directions, tweak a few details, and spend a little time putting my final photo touches into the presentation.\",\"name\":\"Jamie E.\"},{\"quote\":\"I work with Fortune 100 companies and consistently get asked, 'How do you do that? What tool is that?' Prezi makes me far more professional and leaves a lasting impression.\",\"name\":\"Nathan C.\"}]},\"faq\":{\"eyebrow\":\"FAQ\",\"heading\":\"Frequently asked questions\",\"items\":[{\"question\":\"What is Prezi?\",\"answer\":\"Prezi is a presentation platform for people who are accountable for what an audience does next. Bring in slides made anywhere, present them on a zoomable canvas with live polls, quizzes, and Q\u0026A that everyone joins from their phone, then share one link that keeps working after the session ends. Quiz results, audience questions, and feedback show what landed. Prezi is a Leader in both G2’s Presentation Software and Audience Response categories, and more than 170 million people in 195 countries have used it.\"},{\"question\":\"Does Prezi work with PowerPoint and Google Slides?\",\"answer\":\"Yes. Prezi imports PowerPoint, Google Slides, Canva, PDF, and Word files onto its zoomable canvas and keeps your slides looking the way you made them, so you can add polls, quizzes, and Q\u0026A without rebuilding anything. If you want a new look, just ask Prezi to restyle the deck.\"},{\"question\":\"Can I use Prezi with slides I made in ChatGPT?\",\"answer\":\"Yes. Prezi imports slides generated in ChatGPT and other AI tools alongside PowerPoint, Google Slides, Canva, PDF, and Word. Your deck comes in looking the way you made it, and you add live polls, quizzes, Q\u0026A, and a shareable link on top. Prezi takes any slides you already have, whether you created them in ChatGPT, uploaded a PowerPoint or PDF, or brought them in from another tool, and turns them into a full Prezi presentation.\"},{\"question\":\"How does Prezi engage an audience during a presentation?\",\"answer\":\"Prezi builds live polls, quizzes, and Q\u0026A into the presentation itself. The audience scans one QR code and every phone becomes a way to ask, answer, vote, and react. No separate app, no switching tabs.\"},{\"question\":\"Does Prezi work for remote and hybrid sessions?\",\"answer\":\"Yes. Prezi runs the same polls, quizzes, and Q\u0026A whether your audience is in the room, on a call, or half-and-half. Everyone joins the same session and participates the same way, ten feet or ten time zones away.\"},{\"question\":\"Can people who missed a presentation catch up later?\",\"answer\":\"Yes. What you presented becomes a link that keeps teaching: people can revisit the material as a narrated video, listen to it as a podcast, quiz themselves on it, or ask it questions and get answers from your content.\"},{\"question\":\"What can Prezi tell me after a presentation?\",\"answer\":\"Prezi shows quiz and poll results by question, the questions your audience asked, and an end-of-session feedback digest with ratings and comments, so you can see which concepts landed and which need another pass.\"},{\"question\":\"Is Prezi useful for teaching and training?\",\"answer\":\"Yes. Educators use Prezi for lectures that hold attention and material students can revisit until it sticks. Training teams use it for onboarding and upskilling, with self-paced review, SCORM export to an LMS, and results they can share with stakeholders.\"},{\"question\":\"How many people use Prezi?\",\"answer\":\"More than 170 million people use Prezi worldwide, over 500 million presentations have been created with it, and it is used in more than 195 countries.\"},{\"question\":\"Is Prezi free to start?\",\"answer\":\"Yes. You can start creating with Prezi for free without a credit card, and import your existing slides.\"}]},\"finalCta\":{\"heading\":\"Your next session could be the one they remember.\",\"subheading\":\"Bring in the deck you already have and see what changes. Free to start, no credit card.\"},\"footer\":{\"columns\":{\"prezi\":\"Prezi\",\"company\":\"Company\",\"compare\":\"Compare\"},\"links\":{\"preziAi\":\"Prezi AI\",\"testimonials\":\"Testimonials\",\"prompts\":\"Prompts\",\"blog\":\"Blog\",\"preziSupport\":\"Prezi Support\",\"about\":\"About\",\"careers\":\"Careers\",\"press\":\"Press\",\"companyInfo\":\"Company Information\",\"security\":\"Security\",\"legal\":\"Legal\",\"contactUs\":\"Contact Us\",\"canva\":\"Canva\",\"gamma\":\"Gamma\",\"powerPoint\":\"PowerPoint\",\"googleSlides\":\"Google Slides\",\"beautifulAi\":\"Beautiful.ai\"},\"social\":{\"facebook\":\"Facebook\",\"x\":\"X\",\"instagram\":\"Instagram\",\"tiktok\":\"TikTok\",\"linkedin\":\"LinkedIn\",\"reddit\":\"Reddit\"},\"terms\":\"Terms\",\"privacyPolicy\":\"Privacy Policy\",\"footerNav\":\"Footer navigation\"},\"proofStrip\":{\"ratingOnG2\":\"4.6 on G2\",\"stat170m\":\"170M+\",\"presenters\":\"presenters\",\"stat500m\":\"500M+\",\"presentationsCreated\":\"presentations created\"},\"vignetteGrid\":{\"phoneAlt\":\"A hand holding a phone to scan a QR code\",\"ipadAlt\":\"Hands holding an iPad with a Prezi presentation\",\"podcastAlt\":\"A listener enjoying a Prezi video presentation\",\"handAlt\":\"A friendly raised hand\",\"videoCallAlt\":\"A presenter sharing their screen in a video call\",\"pres